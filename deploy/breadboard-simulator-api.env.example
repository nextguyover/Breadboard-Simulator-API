# Copied to /etc/breadboard-simulator-api.env by install.sh (which fills in the two secrets).

# Branch the auto-updater (and bsim-api-update) deploys from.
DEPLOY_BRANCH=prod

# Listen address. Keep 127.0.0.1 when cloudflared runs in the same container.
HOST=127.0.0.1
PORT=8787

# SQLite file. /var/lib/breadboard-simulator-api is created by systemd (StateDirectory).
DB_PATH=/var/lib/breadboard-simulator-api/reports.db

# Secrets: long random strings, e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=
IP_HASH_SALT=

# Comma separated list of web app origins allowed to submit reports.
ALLOWED_ORIGINS=https://app.breadboardsimulator.com
# Where "Open the reported circuit" links on the admin page point.
APP_URL=https://app.breadboardsimulator.com/

# 1 = use Cloudflare's CF-Connecting-IP header as the client IP. Only safe when the
# server is reachable through Cloudflare alone (Cloudflare Tunnel, or a firewall).
TRUST_CLOUDFLARE=1

# Per-IP limits for submitting reports.
RATE_PER_IP_WINDOW_SEC=600
RATE_PER_IP_WINDOW_MAX=5
RATE_PER_IP_DAILY_MAX=20

# Wrong admin tokens: this many from one IP within the window locks that IP out of the admin endpoints.
AUTH_FAIL_MAX=5
AUTH_FAIL_WINDOW_SEC=900
AUTH_LOCKOUT_SEC=3600

# Optional global limits, off (0) by default.
RATE_GLOBAL_PER_SEC=0
RATE_GLOBAL_BURST=10
RATE_GLOBAL_DAILY_MAX=0

# Size limits in bytes.
MAX_BODY_BYTES=3145728
MAX_SCREENSHOT_BYTES=2097152
